{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting / Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/frontend/*", "src/*"],
      "@/platform/*": ["src/frontend/platform/*"],
      "@/shared/*": ["src/frontend/shared/*"],
      "@/components/*": ["src/frontend/shared/*"],
      "@/portals/*": ["src/frontend/platform/*"],
      "@/services/*": ["src/frontend/services/*"],
      "@/store/*": ["src/frontend/store/*"],
      "@/theme/*": ["src/frontend/theme/*"],
      "@/types/*": ["src/frontend/types/*"],
      "@/language/*": ["src/frontend/language/*"],
      "@/locales/*": ["src/frontend/language/*"],
      "@/lib/*": ["src/frontend/shared/lib/*"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
